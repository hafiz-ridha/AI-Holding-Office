# ===== AI Virtual Holding — environment (copy to .env and edit) =====

# Secret used to encrypt AI provider API keys and the Telegram bot token (min. 32 chars).
# Generate: openssl rand -base64 48
# KEEP IT SAFE: backups can only decrypt stored keys with the same APP_SECRET.
APP_SECRET=

# First admin account (created only when the database has no users).
# If ADMIN_PASSWORD is empty a random password is generated and printed ONCE in the container log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Public URL of the dashboard (used as HTTP-Referer for OpenRouter attribution).
APP_URL=https://office.example.com

# Host port bound on 127.0.0.1 (aaPanel reverse proxy target: http://127.0.0.1:HOST_PORT).
HOST_PORT=3000

# Reverse-proxy trust (loopback + private ranges covers aaPanel Nginx -> Docker bridge).
TRUST_PROXY=loopback,uniquelocal

# Session cookie "Secure" flag: auto (follows X-Forwarded-Proto), true, or false.
COOKIE_SECURE=auto

# Default timezone for new installs (Telegram report time also has its own setting in the dashboard).
TZ_DEFAULT=Asia/Jakarta

# info | warn | error | debug
LOG_LEVEL=info

# Advanced (optional)
# TELEGRAM_API_BASE=https://api.telegram.org
# QUEUE_INTERVAL_MS=5000
# SCHEDULER_INTERVAL_MS=30000
